    "/v1/atomicals-realms/resolve": {
      "get": {
        "operationId": "resolveRealm",
        "tags": ["Names"],
        "summary": "Resolve a name to its verified winner",
        "description": "Only a status of verified means the rules awarded the name. Re-resolve immediately before acting rather than trusting a cached answer.",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/NameQuery" }],
        "responses": {
          "200": {
            "description": "Resolution result.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RealmResolution" },
                "examples": {
                  "verified": {
                    "summary": "A verified winner",
                    "value": {
                      "name": "example",
                      "normalizedName": "example",
                      "status": "verified",
                      "atomicalId": "4d0b1f1c9c53a5b1e0b1b2c3d4e5f60718293a4b5c6d7e8f9a0b1c2d3e4f5061i0",
                      "candidates": [],
                      "reason": null
                    }
                  },
                  "candidate": {
                    "summary": "Still a candidate, not owned",
                    "value": {
                      "name": "example",
                      "normalizedName": "example",
                      "status": "candidate",
                      "atomicalId": null,
                      "candidates": [],
                      "reason": "Resolution has not completed."
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
