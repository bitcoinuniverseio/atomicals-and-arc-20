{
  "inventoryVersion": "1.0.0",
  "service": "index-atomicals-nfts-and-realms",
  "routePrefixRule": "/<indexer-name>/<endpoint-name> with the index- prefix removed, plus a /v1/ segment on versioned surfaces",
  "source": {
    "id": "universe-index-atomicals-nfts-and-realms",
    "path": "src/server.mjs",
    "revision": "1d9109c68d95d5985632a60d6596b3612d3f6ef1",
    "exportedBy": "scripts/export-public-routes.mjs in the runtime repository",
    "note": "Sanitized inventory. No hostname, credential, or internal topology is included."
  },
  "projection": {
    "included": ["nft", "realm", "subrealm"],
    "excluded": ["ft", "dft", "container", "dmitem"],
    "readOnly": true
  },
  "routes": [
    { "method": "GET", "path": "/live", "auth": "none", "summary": "Process liveness" },
    { "method": "GET", "path": "/version", "auth": "none", "summary": "Service and pinned provider revisions" },
    { "method": "GET", "path": "/health", "auth": "none", "summary": "Health state, 503 when unavailable" },
    { "method": "GET", "path": "/ready", "auth": "none", "summary": "Readiness with the reason when not ready" },
    { "method": "GET", "path": "/metrics", "auth": "none", "summary": "Operational metrics in text form, when enabled" },
    { "method": "GET", "path": "/token-explorer/status", "auth": "none", "summary": "Token explorer source status" },
    { "method": "GET", "path": "/token-explorer/{protocol}", "auth": "bearer", "summary": "Token explorer feed page for atomicals or realms", "params": { "protocol": "atomicals|realms" } },
    { "method": "GET", "path": "/v1/atomicals/index/status", "auth": "none", "summary": "Index status with a provider probe" },
    { "method": "GET", "path": "/v1/atomicals-nfts/index/status", "auth": "none", "summary": "Index status, NFT scope" },
    { "method": "GET", "path": "/v1/atomicals-realms/index/status", "auth": "none", "summary": "Index status, Realm scope" },
    { "method": "GET", "path": "/v1/atomicals/index/events", "auth": "none", "summary": "Recent index events" },
    { "method": "POST", "path": "/v1/atomicals/index/refresh", "auth": "admin-token", "summary": "Queue a refresh" },
    { "method": "POST", "path": "/v1/atomicals-nfts/index/refresh", "auth": "admin-token", "summary": "Queue a refresh, NFT scope" },
    { "method": "POST", "path": "/v1/atomicals-realms/index/refresh", "auth": "admin-token", "summary": "Queue a refresh, Realm scope" },
    { "method": "POST", "path": "/v1/atomicals/index/rollback", "auth": "admin-token", "summary": "Roll the active pointer back to a generation" },
    { "method": "GET", "path": "/v1/atomicals/assets", "auth": "none", "summary": "List assets across every projected type" },
    { "method": "GET", "path": "/v1/atomicals-nfts/assets", "auth": "none", "summary": "List plain NFTs" },
    { "method": "GET", "path": "/v1/atomicals-realms/assets", "auth": "none", "summary": "List Realms and Subrealms, filterable by kind" },
    { "method": "GET", "path": "/v1/atomicals/assets/{atomicalId}", "auth": "none", "summary": "Read one asset of any projected type" },
    { "method": "GET", "path": "/v1/atomicals-nfts/assets/{atomicalId}", "auth": "none", "summary": "Read one plain NFT" },
    { "method": "GET", "path": "/v1/atomicals-realms/assets/{atomicalId}", "auth": "none", "summary": "Read one Realm or Subrealm" },
    { "method": "GET", "path": "/v1/atomicals/assets/{atomicalId}/history", "auth": "none", "summary": "Asset history" },
    { "method": "GET", "path": "/v1/atomicals-nfts/assets/{atomicalId}/history", "auth": "none", "summary": "NFT history" },
    { "method": "GET", "path": "/v1/atomicals-realms/assets/{atomicalId}/history", "auth": "none", "summary": "Realm history" },
    { "method": "GET", "path": "/v1/atomicals/assets/{atomicalId}/holders", "auth": "none", "summary": "Current owner, holder scope current-owner" },
    { "method": "GET", "path": "/v1/atomicals-nfts/assets/{atomicalId}/holders", "auth": "none", "summary": "Current owner, NFT scope" },
    { "method": "GET", "path": "/v1/atomicals-realms/assets/{atomicalId}/holders", "auth": "none", "summary": "Current owner, Realm scope" },
    { "method": "GET", "path": "/v1/atomicals/assets/{atomicalId}/metadata", "auth": "none", "summary": "Metadata, media descriptor, and sealed state" },
    { "method": "GET", "path": "/v1/atomicals-nfts/assets/{atomicalId}/metadata", "auth": "none", "summary": "Metadata, NFT scope" },
    { "method": "GET", "path": "/atomicals/media/{atomicalId}/{field}", "auth": "none", "summary": "Stored media bytes with integrity and type restrictions" },
    { "method": "GET", "path": "/v1/atomicals-realms/resolve", "auth": "none", "summary": "Resolve a name to its verified winner" },
    { "method": "GET", "path": "/v1/atomicals-realms/hierarchy", "auth": "none", "summary": "Realm hierarchy for a name" },
    { "method": "GET", "path": "/v1/atomicals-realms/subrealms", "auth": "none", "summary": "Direct Subrealms of a name, with a truncation flag" },
    { "method": "GET", "path": "/v1/atomicals/transactions/{txid}", "auth": "none", "summary": "Projected assets touched by a transaction" },
    { "method": "GET", "path": "/v1/atomicals/blocks/{height}", "auth": "none", "summary": "Projected assets at a block height" },
    { "method": "GET", "path": "/v1/atomicals/utxos/{txid}/{vout}", "auth": "none", "summary": "Projected assets at an outpoint" }
  ]
}
