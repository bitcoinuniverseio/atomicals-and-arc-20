---
import Provenance from '../Provenance.astro'
import PageActions from '../PageActions.astro'
import { isStaleTranslation } from '../../lib/translations'

// Starlight anchors the skip link and 'back to top' at this id.
const PAGE_TITLE_ID = '_top'

const route = Astro.locals.starlightRoute
const data = route.entry.data as typeof route.entry.data & {
  provenance?: Parameters<typeof Provenance>[0]['provenance']
}
const provenance = data.provenance
const staleTranslation = provenance ? await isStaleTranslation(route.id, provenance) : false
---

<h1 id={PAGE_TITLE_ID}>{data.title}</h1>

{data.description && <p class="bu-page-lede">{data.description}</p>}

<PageActions routeId={route.id} />

{provenance && <Provenance provenance={provenance} staleTranslation={staleTranslation} />}

<style>
  h1 {
    margin-top: 1rem;
    margin-bottom: 0.35rem;
    font-size: var(--sl-text-h1);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 640;
    color: var(--bu-ink);
    overflow-wrap: break-word;
  }

  .bu-page-lede {
    margin: 0 0 1rem;
    font-size: var(--bu-step-1);
    line-height: 1.5;
    color: var(--bu-ink-soft);
    max-width: 58ch;
  }
</style>
