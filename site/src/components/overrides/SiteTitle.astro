---
import Default from '@astrojs/starlight/components/SiteTitle.astro'
import CommandPalette from '../CommandPalette.astro'
---

<Default><slot /></Default>
<CommandPalette />

<style>
  /*
   * The custom header has two rows (--bu-header-main-h = 3.5rem and --bu-header-strip-h = 2.5rem),
   * setting --sl-nav-height to 6rem. Starlight calculates the logo image height as:
   *   calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y)) = 4.5rem (72px)
   * which is larger than the 3.5rem main bar and overflows into the context strip.
   * Constrain the mark to 2rem (32px, matching its viewBox).
   */
  :global(.site-title :is(img, svg)) {
    height: 2rem;
    width: 2rem;
    max-height: 2rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  /*
   * Keep the palette component in the DOM so its keyboard shortcut (Ctrl+K) and dialog
   * remain functional, but hide the trigger button completely. It duplicates the
   * header search control on the right and causes layout collisions with the site title.
   */
  :global(bu-command-palette) {
    display: contents;
  }

  :global(.bu-palette-trigger) {
    display: none !important;
  }

  /*
   * Starlight clips the site title with `overflow: hidden; text-overflow: clip`.
   * At 375px the name needs about 180px and gets about 165px, so it rendered as
   * "Atomicals and ARC-2". A silently truncated name is not a cosmetic problem:
   * it shows the reader a name that is not ours, and the missing character is a
   * digit that belongs to the protocol.
   *
   * Scaling the title down on narrow viewports keeps the whole name visible.
   * Clamped so it never drops below a readable size, and only applied where the
   * clipping actually happens.
   */
  @media (max-width: 30rem) {
    :global(.site-title) {
      font-size: clamp(0.82rem, 3.6vw, var(--sl-text-h4));
    }
  }
</style>
