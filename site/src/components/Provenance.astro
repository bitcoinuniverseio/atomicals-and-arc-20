---
/**
 * Source and applicability panel.
 * Rendered from validated frontmatter only. Nothing here is hand-maintained beside the content.
 */
import {
  APPLICABILITY_LABELS,
  EDITORIAL_FALLBACK,
  AUTHORITY_LABELS,
  daysSince,
  getSource,
  shortRevision,
  sourceUrl,
  STALE_AFTER_DAYS,
} from '../lib/sources'

interface Props {
  provenance: {
    pageId: string
    area: string
    audience: string[]
    applicability: string
    authority: string
    networks: string[]
    sources: { id: string; path?: string; note?: string }[]
    docsVersion: string
    activation?: string
    verified: string
    owner: string
    reviewers: string[]
    tags: string[]
    limitations: string[]
    deprecated?: {
      since: string
      reason: string
      replacement?: string
      sunset?: string
    }
    translationSourceHash?: string
    hideProvenance: boolean
  }
  /** Non-null when the page is a translation whose English source has since changed. */
  staleTranslation?: boolean
}

const { provenance, staleTranslation = false } = Astro.props
const applicability =
  APPLICABILITY_LABELS[provenance.applicability] ?? EDITORIAL_FALLBACK
const age = daysSince(provenance.verified)
const stale = age > STALE_AFTER_DAYS
const resolved = provenance.sources.map((ref) => {
  const entry = getSource(ref.id)
  return {
    ref,
    entry,
    href: sourceUrl(entry, ref.path),
    revision: shortRevision(entry),
  }
})
---

{
  provenance.deprecated && (
    <div class="bu-stale" role="note">
      <strong>Deprecated since {provenance.deprecated.since}.</strong>{' '}
      {provenance.deprecated.reason}
      {provenance.deprecated.replacement && (
        <>
          {' '}
          Use <a href={provenance.deprecated.replacement}>the replacement page</a> instead.
        </>
      )}
      {provenance.deprecated.sunset && <> Planned removal: {provenance.deprecated.sunset}.</>}
    </div>
  )
}

{
  staleTranslation && (
    <div class="bu-stale" role="note">
      <strong>This translation is behind the English source.</strong> The English page changed
      after this translation was recorded. Read the English version for the current wording.
    </div>
  )
}

{
  !provenance.hideProvenance && (
    <details class="bu-provenance">
      <summary>
        <span class="bu-chip" data-tone={applicability.tone}>
          {applicability.label}
        </span>
        <span class="bu-chip" data-tone={stale ? 'warn' : 'ok'}>
          {stale ? `Re-check due (verified ${provenance.verified})` : `Verified ${provenance.verified}`}
        </span>
        <span class="bu-provenance-meta">
          <span>Metadata & Sources</span>
          <svg class="bu-provenance-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </span>
      </summary>
      <div class="bu-provenance-body">
        <p style="margin:0">{applicability.meaning}</p>
        <dl>
          <dt>Page ID</dt>
          <dd>
            <code>{provenance.pageId}</code>
          </dd>

          <dt>Normative authority</dt>
          <dd>{AUTHORITY_LABELS[provenance.authority]}</dd>

          <dt>Networks</dt>
          <dd>{provenance.networks.join(', ')}</dd>

          <dt>Documentation version</dt>
          <dd>{provenance.docsVersion}</dd>

          {provenance.activation && (
            <>
              <dt>Activation boundary</dt>
              <dd>{provenance.activation}</dd>
            </>
          )}

          <dt>Audience</dt>
          <dd>{provenance.audience.join(', ')}</dd>

          <dt>Owner</dt>
          <dd>{provenance.owner}</dd>

          {resolved.length > 0 && (
            <>
              <dt>Sources</dt>
              <dd>
                <ul>
                  {resolved.map((item) => (
                    <li>
                      <a href={item.href} rel="noopener noreferrer">
                        {item.entry.name}
                      </a>{' '}
                      at <code>{item.revision}</code>
                      {item.entry.visibility === 'private' && (
                        <>
                          {' '}
                          <span class="bu-chip" data-tone="idle">
                            private repository
                          </span>
                        </>
                      )}
                      {item.ref.note && <> {item.ref.note}</>}
                    </li>
                  ))}
                </ul>
              </dd>
            </>
          )}

          {provenance.limitations.length > 0 && (
            <>
              <dt>Known limitations</dt>
              <dd>
                <ul>
                  {provenance.limitations.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </>
          )}
        </dl>
      </div>
    </details>
  )
}

<style>
  .bu-stale {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border-radius: var(--bu-radius-m);
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: var(--bu-ink);
    font-size: 0.85rem;
  }

  .bu-provenance {
    margin: 0.75rem 0 1.5rem;
    border: 1px solid var(--bu-line);
    border-radius: var(--bu-radius-m);
    background: var(--bu-surface);
    overflow: hidden;
    transition: all 0.15s ease;
  }

  .bu-provenance summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    background: color-mix(in srgb, var(--bu-surface-sunken) 50%, transparent);
    user-select: none;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .bu-provenance summary:hover {
    background: var(--bu-surface-sunken);
  }

  .bu-provenance-meta {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--bu-ink-muted);
  }

  .bu-provenance-chevron {
    transition: transform 0.2s ease;
  }

  .bu-provenance[open] .bu-provenance-chevron {
    transform: rotate(180deg);
  }

  .bu-provenance-body {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--bu-line);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--bu-ink-soft);
  }

  .bu-provenance-body dl {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) 1fr;
    gap: 0.5rem 1rem;
    margin: 0.85rem 0 0;
  }

  .bu-provenance-body dt {
    font-weight: 600;
    color: var(--bu-ink-muted);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .bu-provenance-body dd {
    margin: 0;
    color: var(--bu-ink);
  }

  .bu-provenance-body ul {
    margin: 0;
    padding-inline-start: 1.25rem;
  }

  @media (max-width: 40rem) {
    .bu-provenance-body dl {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
