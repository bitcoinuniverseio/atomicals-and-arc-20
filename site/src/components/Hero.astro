---
import siteMeta from '../data/site.json'
import { docHref } from '../lib/href'
import OrbitalHero from './diagrams/OrbitalHero.astro'

const locale = Astro.locals.starlightRoute?.locale
---

<section class="bu-hero">
  <div>
    <p class="bu-hero-kicker">Bitcoin-native digital objects and fungible units</p>
    <h1>Atomicals, explained from source to execution.</h1>
    <p>
      Version-pinned protocol documentation, deterministic labs, API conformance, safe UTXO
      planning and agent-ready workflows for ARC-20, NFTs, Realms, Containers, DMINT and AVM.
    </p>
    <div class="bu-hero-actions">
      <a class="bu-btn" data-variant="primary" href={docHref('/start/choose-your-path/', locale)}>
        Start building
      </a>
      <a class="bu-btn" href={docHref('/tools/', locale)}>Open Protocol Lab</a>
      <a class="bu-btn" href={docHref('/releases/versions/', locale)}>Inspect the sources</a>
    </div>
  </div>
  <OrbitalHero />
</section>

<style>
  .bu-hero-kicker {
    margin: 0 0 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bu-accent-strong);
  }
</style>
