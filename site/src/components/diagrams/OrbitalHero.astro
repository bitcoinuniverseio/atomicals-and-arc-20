---
import Figure from '../Figure.astro'
---

<Figure
  id="fig-orbital-hero"
  title="One satoshi, from UTXO to object"
  summary="A single satoshi can be plain bitcoin, an ARC-20 unit, or a non-fungible Atomical. Creating an Atomical follows two steps: a commit pays to a Taproot output, then a reveal spends it. The object is assigned to output zero of the reveal, and nothing exists before that reveal."
>
  <svg viewBox="0 0 640 360" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <marker id="oh-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--d-accent)" />
      </marker>
      <linearGradient id="oh-satoshi" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="var(--d-accent-fill)" />
        <stop offset="100%" stop-color="var(--d-accent-quiet)" />
      </linearGradient>
    </defs>

    <g font-family="var(--bu-font-sans)">
      <rect x="20" y="20" width="600" height="320" rx="18" fill="var(--d-fill)" stroke="var(--d-line)" />

      <rect x="42" y="42" width="556" height="56" rx="13" fill="url(#oh-satoshi)" stroke="var(--d-line)" />
      <circle cx="72" cy="70" r="16" fill="var(--d-accent-quiet)" stroke="var(--d-bitcoin)" stroke-width="1.5" />
      <text x="72" y="75" text-anchor="middle" fill="var(--d-ink)" font-size="15" font-weight="760">1</text>
      <text x="100" y="65" fill="var(--d-accent)" font-size="10.5" font-weight="750" letter-spacing="1.15">ONE SATOSHI</text>
      <text x="100" y="83" fill="var(--d-ink)" font-size="14" font-weight="720">One role at a time</text>
      <text x="578" y="74" text-anchor="end" fill="var(--d-soft)" font-size="11.5">A clear path to an Atomical</text>

      <path d="M190 180 H238" fill="none" stroke="var(--d-accent)" stroke-width="1.7" marker-end="url(#oh-arrow)" />
      <path d="M394 180 H442" fill="none" stroke="var(--d-accent)" stroke-width="1.7" marker-end="url(#oh-arrow)" />

      <g>
        <rect x="42" y="126" width="148" height="108" rx="13" fill="var(--d-fill)" stroke="var(--d-line)" />
        <text x="58" y="151" fill="var(--d-soft)" font-size="10.5" font-weight="750" letter-spacing="1">01  WALLET</text>
        <text x="58" y="181" fill="var(--d-ink)" font-size="16" font-weight="760">Choose a UTXO</text>
        <text x="58" y="203" fill="var(--d-soft)" font-size="11.5">Select the satoshi to use.</text>
        <circle cx="171" cy="151" r="5" fill="var(--d-ok)" />
      </g>

      <g>
        <rect x="246" y="126" width="148" height="108" rx="13" fill="var(--d-fill)" stroke="var(--d-line)" />
        <text x="262" y="151" fill="var(--d-accent)" font-size="10.5" font-weight="750" letter-spacing="1">02  COMMIT</text>
        <text x="262" y="180" fill="var(--d-ink)" font-size="16" font-weight="760">Lock the path</text>
        <text x="262" y="202" fill="var(--d-soft)" font-size="11.5">Pay to a Taproot output.</text>
        <circle cx="375" cy="151" r="5" fill="var(--d-accent)" />
      </g>

      <g>
        <rect x="450" y="126" width="148" height="108" rx="13" fill="var(--d-accent-quiet)" stroke="var(--d-accent)" />
        <text x="466" y="151" fill="var(--d-accent)" font-size="10.5" font-weight="750" letter-spacing="1">03  REVEAL</text>
        <text x="466" y="180" fill="var(--d-ink)" font-size="16" font-weight="760">Output 0</text>
        <text x="466" y="202" fill="var(--d-soft)" font-size="11.5">Carries the object now.</text>
        <circle cx="579" cy="151" r="5" fill="var(--d-ok)" />
      </g>

      <text x="42" y="263" fill="var(--d-soft)" font-size="10.5" font-weight="730" letter-spacing="0.9">A SATOSHI CAN BE RECOGNIZED AS</text>

      <g font-size="11.5" font-weight="680">
        <rect x="42" y="276" width="166" height="34" rx="10" fill="var(--d-fill)" stroke="var(--d-line)" />
        <circle cx="59" cy="293" r="4.5" fill="var(--d-bitcoin)" />
        <text x="72" y="297" fill="var(--d-ink)">Plain bitcoin</text>

        <rect x="221" y="276" width="166" height="34" rx="10" fill="var(--d-fill)" stroke="var(--d-line)" />
        <circle cx="238" cy="293" r="4.5" fill="var(--d-ok)" />
        <text x="251" y="297" fill="var(--d-ink)">ARC-20 unit</text>

        <rect x="400" y="276" width="198" height="34" rx="10" fill="var(--d-fill)" stroke="var(--d-line)" />
        <circle cx="417" cy="293" r="4.5" fill="var(--d-accent)" />
        <text x="430" y="297" fill="var(--d-ink)">Non-fungible Atomical</text>
      </g>

      <text x="320" y="328" text-anchor="middle" fill="var(--d-soft)" font-size="11.5">Nothing exists until the reveal.</text>
    </g>
  </svg>
</Figure>
