---
/**
 * Copy the page as Markdown, or open the raw Markdown file.
 * Both point at the generated /raw/ tree so agents and humans get the same bytes.
 */
interface Props {
  routeId: string
}
const { routeId } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const rawHref = `${base}/raw/${routeId.replace(/\/$/, '') || 'index'}.md`
---

<div class="bu-action-bar print:hidden">
  <bu-copy-markdown data-src={rawHref}>
    <button type="button" class="bu-action-bar-btn" data-copy aria-label="Copy page as Markdown">
      <svg class="bu-action-bar-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
      </svg>
      <span class="bu-btn-label">Copy Markdown</span>
    </button>
  </bu-copy-markdown>
  <span class="bu-action-bar-sep" aria-hidden="true"></span>
  <a href={rawHref} class="bu-action-bar-btn bu-action-bar-link" target="_blank" rel="noopener noreferrer" aria-label="View raw Markdown">
    <svg class="bu-action-bar-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
      <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
      <polyline points="14 2 14 8 20 8"/>
    </svg>
    <span>Raw</span>
  </a>
</div>

<script>
  class BuCopyMarkdown extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button')
      const label = this.querySelector('.bu-btn-label')
      const src = this.dataset.src
      if (!button || !src || !label) return
      const original = label.textContent ?? 'Copy Markdown'
      button.addEventListener('click', async () => {
        button.disabled = true
        try {
          const response = await fetch(src)
          if (!response.ok) throw new Error(String(response.status))
          await navigator.clipboard.writeText(await response.text())
          label.textContent = 'Copied!'
          button.classList.add('is-copied')
        } catch {
          label.textContent = 'Failed'
        } finally {
          window.setTimeout(() => {
            label.textContent = original
            button.classList.remove('is-copied')
            button.disabled = false
          }, 2000)
        }
      })
    }
  }
  customElements.define('bu-copy-markdown', BuCopyMarkdown)
</script>

<style>
  .bu-action-bar {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--bu-line);
    border-radius: 8px;
    background: var(--bu-surface);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    overflow: hidden;
    height: 2rem;
    padding: 0;
    margin: 0;
    vertical-align: middle;
  }

  bu-copy-markdown {
    display: contents;
  }

  .bu-action-bar-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 100%;
    padding: 0 0.65rem;
    font-size: 0.76rem;
    font-weight: 550;
    color: var(--bu-ink-soft);
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    outline: none;
    text-decoration: none;
    cursor: pointer;
    line-height: 1;
    transition: all 0.15s ease;
    white-space: nowrap;
    box-shadow: none !important;
    min-height: unset !important;
  }

  .bu-action-bar-btn:hover {
    color: var(--bu-ink);
    background: var(--bu-surface-sunken) !important;
  }

  .bu-action-bar-btn.is-copied {
    color: var(--bu-ok);
  }

  .bu-action-bar-icon {
    color: var(--bu-ink-muted);
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  .bu-action-bar-btn:hover .bu-action-bar-icon {
    color: var(--bu-ink);
  }

  .bu-action-bar-sep {
    display: inline-block;
    width: 1px;
    height: 1rem;
    background: var(--bu-line);
    flex-shrink: 0;
  }
</style>
