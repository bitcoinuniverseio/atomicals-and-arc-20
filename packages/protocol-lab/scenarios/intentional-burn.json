  "seed": "arc20-burn-ok",
  "network": "regtest",
  "steps": [
    { "type": "fund", "label": "fund", "outputs": [
      { "value": 30000, "address": "bc1qholder" }
    ] },
    { "type": "reveal", "label": "mint", "inputs": ["fundo0"], "outputs": [
      { "value": 546, "address": "bc1qholder" },
      { "value": 29400, "address": "bc1qholder" }
    ], "atomical": { "type": "ft", "ticker": "GOLD", "units": 546 } },
    { "type": "confirm", "blocks": 1 },
    { "type": "transfer", "label": "burn", "inputs": ["minto0", "minto1"], "outputs": [
      { "value": 274, "address": "bc1qnull", "unspendable": true },
