{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitcoinuniverseio.github.io/atomicals-and-arc-20/packages/protocol-lab/scenario.schema.json",
  "title": "Protocol Lab scenario",
  "description": "A deterministic, key-free Atomicals workflow. Identifiers are synthetic and derived from the seed.",
  "type": "object",
  "required": ["scenarioVersion", "id", "title", "seed", "steps"],
  "additionalProperties": false,
  "properties": {
    "scenarioVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string" },
    "seed": { "type": "string", "minLength": 1 },
    "network": { "enum": ["mainnet", "testnet", "signet", "regtest"] },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "output": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "address": { "type": "string", "minLength": 1 },
        "scriptType": { "enum": ["p2tr", "p2wpkh", "p2sh", "legacy"] },
        "unspendable": { "type": "boolean" }
      }
    },
    "step": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "$ref": "#/$defs/fund" },
        { "$ref": "#/$defs/reveal" },
        { "$ref": "#/$defs/transfer" },
        { "$ref": "#/$defs/confirm" },
        { "$ref": "#/$defs/reorg" }
      ]
    },
    "fund": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "fund" },
        "label": { "type": "string" },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/output" } }
      }
    },
    "reveal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "reveal" },
        "label": { "type": "string" },
        "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/output" } },
        "changeAddress": { "type": "string" },
        "atomical": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["nft", "ft", "realm", "subrealm", "container"] },
            "ticker": { "type": "string" },
            "units": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "transfer" },
        "label": { "type": "string" },
        "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/output" } }
      }
    },
    "confirm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "confirm" },
        "label": { "type": "string" },
        "blocks": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "reorg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "reorg" },
        "label": { "type": "string" },
        "depth": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    }
  }
}
