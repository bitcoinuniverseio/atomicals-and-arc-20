{
  "name": "@bitcoin-universe/atomicals-docs-mcp",
  "version": "1.0.0",
  "description": "Read-only Model Context Protocol server over the built Atomicals and ARC-20 documentation artefacts",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "bin": { "atomicals-docs-mcp": "./dist/server.js" },
