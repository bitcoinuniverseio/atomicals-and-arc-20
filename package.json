{
  "name": "@bitcoin-universe/atomicals-and-arc-20",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Atomicals protocol and ARC-20 documentation platform, contracts, and conformance material",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "workspaces": [
    "site",
    "packages/client",
    "packages/mcp",
    "packages/protocol-core",
    "packages/protocol-lab",
    "packages/utxo-planner",
    "packages/conformance",
    "packages/avm-runtime"
  ],
  "scripts": {
    "generate": "node scripts/generate-all.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/*.test.mjs\" \"packages/*/test/*.test.mjs\"",
    "check": "node scripts/check-all.mjs",
    "verify": "npm run generate && npm run check && npm test && npm run build",
    "lab:up": "node scripts/lab.mjs up",
    "lab:seed": "node scripts/lab.mjs seed",
    "lab:status": "node scripts/lab.mjs status",
    "lab:test": "node scripts/lab.mjs test",
    "lab:reset": "node scripts/lab.mjs reset",
    "lab:down": "node scripts/lab.mjs down",
    "lab:logs": "node scripts/lab.mjs logs",
    "lab:proxy": "node lab/proxy/conformance-proxy.mjs",
    "workflows:validate": "node scripts/generate-workflows.mjs",
    "sdk:generate": "node scripts/generate-sdks.mjs",
    "packs:generate": "node scripts/generate-protocol-packs.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.2",
    "@img/sharp-libvips-linux-x64": "1.3.3",
    "@img/sharp-linux-x64": "0.35.4"
  }
}
